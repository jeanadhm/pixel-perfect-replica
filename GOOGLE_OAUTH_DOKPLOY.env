# Configuration Google OAuth pour Analytics AMBS
# À ajouter dans Dokploy > Analytics AMBS > Environment, sans modifier les autres variables.

# Déjà défini pour la production
APP_ORIGIN=https://analytics.ambs-agency.com
GOOGLE_REDIRECT_URI=https://analytics.ambs-agency.com/api/google/callback

# À copier depuis Google Cloud Console > API et services > Identifiants > Client OAuth 2.0 (Application Web)
GOOGLE_CLIENT_ID=COLLER_ICI_LE_CLIENT_ID_GOOGLE
GOOGLE_CLIENT_SECRET=COLLER_ICI_LE_CLIENT_SECRET_GOOGLE

# À configurer dans Google Cloud Console
# Origine JavaScript autorisée : https://analytics.ambs-agency.com
# URI de redirection autorisée : https://analytics.ambs-agency.com/api/google/callback
# APIs à activer :
# - Google Search Console API
# - Google Analytics Data API
# - Google Analytics Admin API

# Le serveur détecte les propriétés accessibles et les relie automatiquement
# aux domaines AMBS Agency, Leads, DialAgent et Factory. Les associations déjà
# présentes ne sont jamais écrasées.
#
# Réglages d'automatisation inclus dans docker-compose.yml :
# AUTO_SYNC_ENABLED=true
# AUTO_SYNC_INTERVAL_MINUTES=240
#
# Search Console est synchronisé jusqu'à J-3 (délai Google) et GA4 jusqu'à J-1.
