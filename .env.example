POSTGRES_DB=analytics_ambs
POSTGRES_USER=analytics
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgresql://analytics:CHANGE_ME@postgres:5432/analytics_ambs
APP_ORIGIN=http://localhost:3000
API_PORT=4000
API_HOST=127.0.0.1
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# The server discovers properties by domain and refreshes Google data every 4 hours.
# Search Console itself publishes final data with a 2-3 day delay.
AUTO_SYNC_ENABLED=true
AUTO_SYNC_INTERVAL_MINUTES=240
# Public competitor and technical monitoring is independent of Google OAuth.
AUTO_MONITORING_ENABLED=true
AUTO_MONITORING_INTERVAL_MINUTES=720
# Public sitemap crawl cadence. The worker skips sites already crawled recently.
AUTO_CRAWL_INTERVAL_HOURS=24
# Optional DataForSEO credentials for live backlink imports. Keep server-side only.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
# Les événements sont relevés en agrégats sans données personnelles. Exemple :
# SITE_EVENT_EXPORTS={"ambs":{"url":"https://ambs-agency.com/api/analytics/export/events","token":"jeton-identique-au-site"}}
SITE_EVENT_EXPORTS=
AUTO_EVENT_SYNC_ENABLED=true
AUTO_EVENT_SYNC_INTERVAL_MINUTES=15
# La découverte concurrentielle est hebdomadaire car elle consomme des crédits DataForSEO.
AUTO_COMPETITOR_DISCOVERY_ENABLED=true
AUTO_COMPETITOR_DISCOVERY_INTERVAL_HOURS=168
# Required only for initial account setup in production; remove after setup.
SETUP_TOKEN=
